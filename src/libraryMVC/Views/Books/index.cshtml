@model libraryMVC.DTOs.Lists.BooksIndexViewModel

@{
    ViewData["Title"] = "Books";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h2 class="mb-0 fw-bold">Books</h2>
        <p class="text-muted small mb-0">Book Inventory &amp; Data Explorer</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
        {
            <a asp-controller="Reports" asp-action="BooksPdf" asp-route-search="@Model.Filters.Search" asp-route-categoryId="@Model.Filters.CategoryId" asp-route-authorId="@Model.Filters.AuthorId" class="btn btn-outline-danger">
                <i class="bi bi-file-earmark-pdf me-1"></i> PDF
            </a>
            <a asp-controller="Reports" asp-action="BooksExcel" asp-route-search="@Model.Filters.Search" asp-route-categoryId="@Model.Filters.CategoryId" asp-route-authorId="@Model.Filters.AuthorId" class="btn btn-outline-success">
                <i class="bi bi-file-earmark-excel me-1"></i> Excel
            </a>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Create New
            </a>
        }
    </div>
</div>

<form id="book-filters" asp-action="Index" method="get" class="card shadow-sm border-0 mb-3">
    <div class="card-body d-flex flex-wrap align-items-end gap-3">
        <div class="flex-grow-1">
            <label for="book-search" class="form-label">Search title or ISBN</label>
            <input id="book-search" name="Search" value="@Model.Filters.Search" class="form-control" placeholder="Title or ISBN" />
        </div>
        <div class="flex-grow-1">
            <label for="book-author" class="form-label">Author</label>
            <select id="book-author" name="AuthorId" class="form-select">
                <option value="">All authors</option>
                @foreach (var author in Model.Options.Authors)
                {
                    <option value="@author.Id" selected="@(Model.Filters.AuthorId == author.Id)">@author.Name</option>
                }
            </select>
        </div>
        <div class="flex-grow-1">
            <label for="book-category" class="form-label">Category</label>
            <select id="book-category" name="CategoryId" class="form-select">
                <option value="">All categories</option>
                @foreach (var category in Model.Options.Categories)
                {
                    <option value="@category.Id" selected="@(Model.Filters.CategoryId == category.Id)">@category.Name</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="card shadow-sm border-0 mb-5" data-infinite-list>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table obs-table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ISBN</th>
                        <th>Title</th>
                        <th>Categories</th>
                        <th>Summary</th>
                        <th>Last Update</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody id="book-list-rows"
                       data-load-more-url="@Url.Action("LoadMore")"
                       data-filter-form-id="book-filters"
                       data-next-page="2"
                       data-has-more="@Model.Results.HasMore.ToString().ToLowerInvariant()">
                    @await Html.PartialAsync("_Rows", Model.Results)
                </tbody>
            </table>
        </div>
        <div class="infinite-list-status p-3 text-center"
             data-infinite-status
             data-sentinel
             aria-live="polite"
             role="status"
             data-has-more="@Model.Results.HasMore.ToString().ToLowerInvariant()">
            @if (!Model.Results.Items.Any())
            {
                <span>No books match these filters.</span>
            }
        </div>
        <div class="text-center p-3">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-load-more hidden="@(!Model.Results.HasMore)">
                Load more
            </button>
        </div>
    </div>
</div>
