@model libraryMVC.DTOs.Lists.PageSlice<libraryMVC.DTOs.Lists.AuthorListItem>

@foreach (var item in Model.Items)
{
    <tr>
        <td class="ps-3 fw-semibold">
            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-light hover-accent">
                @item.FirstName @item.LastName
            </a>
        </td>
        <td><span class="obs-tag-mono">@(string.IsNullOrWhiteSpace(item.Nationality) ? "N/A" : item.Nationality)</span></td>
        <td class="text-secondary small"><i class="bi bi-calendar-event me-1 text-muted"></i>@item.BirthDate.ToString("dd MMM yyyy")</td>
        <td class="text-secondary small">
            @if (item.UpdatedAt.HasValue)
            {
                <span title="@item.UpdatedAt.Value.ToString("F")"><i class="bi bi-clock-history me-1 text-muted"></i>@item.UpdatedAt.Value.ToString("dd MMM yyyy, HH:mm")</span>
            }
            else
            {
                <span class="text-muted fst-italic">No updates</span>
            }
        </td>
        <td>
            @if (item.IsActive)
            {
                <span class="obs-status-dot active">Active</span>
            }
            else
            {
                <span class="obs-status-dot inactive">Inactive</span>
            }
        </td>
        <td class="text-end pe-3">
            @if (User.IsInRole("Admin"))
            {
                <div class="dropdown">
                    <button class="btn btn-sm border-0 shadow-none p-1 text-secondary" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" aria-label="Actions for @item.FirstName @item.LastName">
                        <i class="bi bi-three-dots-vertical fs-5"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil me-2 text-primary"></i>Edit</a></li>
                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-info-circle me-2 text-info"></i>Details</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            @if (item.IsActive)
                            {
                                <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="dropdown-item text-danger" onclick="return confirm('Are you sure you want to delete this author?');"><i class="bi bi-trash me-2"></i>Delete</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Restore" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="dropdown-item text-success" onclick="return confirm('Are you sure you want to activate this author?');"><i class="bi bi-arrow-counterclockwise me-2"></i>Activate</button>
                                </form>
                            }
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
            }
        </td>
    </tr>
}
<tr hidden data-list-page-metadata data-has-more="@Model.HasMore.ToString().ToLowerInvariant()"></tr>
