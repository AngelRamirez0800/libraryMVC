@model libraryMVC.Models.Author

@{
    ViewData["Title"] = "Create Author";
    var booksList = ViewBag.Books as IEnumerable<libraryMVC.Models.Book>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Create Author</h2>
        <p class="text-muted small mb-0">Create a new author and assign books</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="FirstName" class="control-label fw-semibold">First Name</label>
                        <input asp-for="FirstName" class="form-control" placeholder="e.g. Gabriel" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="LastName" class="control-label fw-semibold">Last Name</label>
                        <input asp-for="LastName" class="form-control" placeholder="e.g. García Márquez" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Nationality" class="control-label fw-semibold">Nationality</label>
                        <input asp-for="Nationality" class="form-control" placeholder="e.g. Colombian" />
                        <span asp-validation-for="Nationality" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="BirthDate" class="control-label fw-semibold">Birth Date</label>
                        <input asp-for="BirthDate" type="date" class="form-control" />
                        <span asp-validation-for="BirthDate" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label for="selectedBookIds" class="control-label fw-semibold">Books (Optional)</label>
                        <select id="selectedBookIds" name="selectedBookIds" class="form-select" multiple size="4">
                            @if (booksList != null && booksList.Any())
                            {
                                foreach (var book in booksList)
                                {
                                    <option value="@book.Id">@book.Title (ISBN: @book.Isbn)</option>
                                }
                            }
                        </select>
                        <small class="form-text text-muted">
                            Hold down the <kbd>Ctrl</kbd> (or <kbd>Cmd</kbd>) key to select multiple books.
                        </small>
                    </div>
                    
                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-primary shadow-sm me-2">
                            <i class="bi bi-plus-lg me-1"></i> Create
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
