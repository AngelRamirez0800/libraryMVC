@model libraryMVC.DTOs.Lists.CategoriesIndexViewModel

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h2 class="mb-0 fw-bold">Categories</h2>
        <p class="text-muted small mb-0">Category Directory</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
        {
            <a asp-controller="Reports" asp-action="CategoriesPdf" asp-route-search="@Model.Filters.Search" class="btn btn-outline-danger">
                <i class="bi bi-file-earmark-pdf me-1"></i> PDF
            </a>
            <a asp-controller="Reports" asp-action="CategoriesExcel" asp-route-search="@Model.Filters.Search" class="btn btn-outline-success">
                <i class="bi bi-file-earmark-excel me-1"></i> Excel
            </a>
        }
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Create New
            </a>
        }
    </div>
</div>

<form id="category-filters" asp-action="Index" method="get" class="card shadow-sm border-0 mb-3">
    <div class="card-body d-flex flex-wrap align-items-end gap-3">
        <div class="flex-grow-1">
            <label for="category-search" class="form-label">Search category</label>
            <input id="category-search" name="Search" value="@Model.Filters.Search" class="form-control" placeholder="Category name" />
        </div>
        <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="card shadow-sm border-0 mb-5" data-infinite-list>
    <div class="card-body p-0">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger m-3">@TempData["Error"]</div>
        }
        <div class="table-responsive">
            <table class="table obs-table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Name</th>
                        <th>Description</th>
                        <th>Books</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody id="category-list-rows"
                       data-load-more-url="@Url.Action("LoadMore")"
                       data-filter-form-id="category-filters"
                       data-next-page="2"
                       data-has-more="@Model.Results.HasMore.ToString().ToLowerInvariant()">
                    @await Html.PartialAsync("_Rows", Model.Results)
                </tbody>
            </table>
        </div>
        <div class="infinite-list-status p-3 text-center"
             data-infinite-status
             data-sentinel
             aria-live="polite"
             role="status"
             data-has-more="@Model.Results.HasMore.ToString().ToLowerInvariant()">
            @if (!Model.Results.Items.Any())
            {
                <span>No categories match this search.</span>
            }
        </div>
        <div class="text-center p-3">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-load-more hidden="@(!Model.Results.HasMore)">Load more</button>
        </div>
    </div>
</div>
