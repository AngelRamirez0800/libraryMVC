@model IEnumerable<libraryMVC.Models.Author>

@{
    ViewData["Title"] = "Authors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Authors</h2>
        <p class="text-muted small mb-0">Author directory and management</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Create New
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Name</th>
                        <th>Nationality</th>
                        <th>Birth Date</th>
                        <th>Last Update</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
            @foreach (var item in Model) {
                    <tr>
                        <td class="ps-3 fw-semibold">
                            @item.FirstName @item.LastName
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border font-monospace">
                                @(string.IsNullOrWhiteSpace(item.Nationality) ? "N/A" : item.Nationality)
                            </span>
                        </td>
                        <td class="text-secondary small">
                            <i class="bi bi-calendar-event me-1 text-muted"></i>@item.BirthDate.ToString("dd MMM yyyy")
                        </td>
                        <td class="text-secondary small">
                            @if (item.UpdatedAt.HasValue)
                            {
                                <span title="@item.UpdatedAt.Value.ToString("F")">
                                    <i class="bi bi-clock-history me-1 text-muted"></i>@item.UpdatedAt.Value.ToString("dd MMM yyyy, HH:mm")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No updates</span>
                            }
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge rounded-pill bg-success text-white border border-success px-2 py-1">Active</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-danger text-white border border-danger px-2 py-1">Inactive</span>
                            }
                        </td>
                        <td class="text-end pe-3">
                            <div class="dropdown">
                                <button class="btn btn-sm border-0 shadow-none p-1 text-secondary" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical fs-5"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">
                                            <i class="bi bi-pencil me-2 text-primary"></i> Edit
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">
                                            <i class="bi bi-info-circle me-2 text-info"></i> Details
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        @if (item.IsActive)
                                        {
                                            <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline">
                                                <button type="submit" class="dropdown-item text-danger"
                                                        onclick="return confirm('Are you sure you want to delete this author?');">
                                                    <i class="bi bi-trash me-2"></i> Delete
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Restore" asp-route-id="@item.Id" method="post" class="d-inline">
                                                <button type="submit" class="dropdown-item text-success"
                                                        onclick="return confirm('Are you sure you want to activate this author?');">
                                                    <i class="bi bi-arrow-counterclockwise me-2"></i> Activate
                                                </button>
                                            </form>
                                        }
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
            }
                </tbody>
            </table>
        </div>
    </div>
</div>
