@model libraryMVC.Models.Author

@{
    ViewData["Title"] = "Edit Author";
    var booksList = ViewBag.Books as IEnumerable<libraryMVC.Models.Book>;
    var assignedBookIds = Model.Books?.Select(b => b.Id).ToHashSet() ?? new HashSet<Guid>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Edit Author</h2>
        <p class="text-muted small mb-0">Update author information and assigned books</p>
    </div>
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info me-2">
            <i class="bi bi-info-circle me-1"></i> Details
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" value="@Model.Id" />
                    
                    <div class="form-group mb-3">
                        <label asp-for="FirstName" class="control-label fw-semibold">First Name</label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="LastName" class="control-label fw-semibold">Last Name</label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Nationality" class="control-label fw-semibold">Nationality</label>
                        <input asp-for="Nationality" class="form-control" />
                        <span asp-validation-for="Nationality" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="BirthDate" class="control-label fw-semibold">Birth Date</label>
                        <input asp-for="BirthDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                        <span asp-validation-for="BirthDate" class="text-danger"></span>
                    </div>

                    <div class="form-group form-check mb-3">
                        <label class="form-check-label">
                            <input class="form-check-input" asp-for="IsActive" /> Active
                        </label>
                    </div>

                    <div class="form-group mb-3">
                        <label for="selectedBookIds" class="control-label fw-semibold">Assigned Books</label>
                        <select id="selectedBookIds" name="selectedBookIds" class="form-select" multiple size="4">
                            @if (booksList != null && booksList.Any())
                            {
                                foreach (var book in booksList)
                                {
                                    var isSelected = assignedBookIds.Contains(book.Id);
                                    <option value="@book.Id" selected="@isSelected">
                                        @book.Title (ISBN: @book.Isbn)
                                    </option>
                                }
                            }
                        </select>
                        <small class="form-text text-muted">
                            Hold down the <kbd>Ctrl</kbd> key to select or deselect books.
                        </small>
                    </div>
                    
                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-primary shadow-sm me-2">
                            Save
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
