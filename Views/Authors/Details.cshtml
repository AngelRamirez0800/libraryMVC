@model libraryMVC.Models.Author

@{
    ViewData["Title"] = "Author Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Author Details</h2>
        <p class="text-muted small mb-0">Detailed information about this author</p>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary shadow-sm me-2">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                <h5 class="card-title mb-0 fw-semibold">@Model.FirstName @Model.LastName</h5>
                @if (Model.IsActive)
                {
                    <span class="badge rounded-pill bg-success text-white border border-success px-3 py-1">Active</span>
                }
                else
                {
                    <span class="badge rounded-pill bg-danger text-white border border-danger px-3 py-1">Inactive</span>
                }
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-3 text-muted fw-semibold">First Name</div>
                    <div class="col-sm-9 text-secondary">
                        @Model.FirstName
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-3 text-muted fw-semibold">Last Name</div>
                    <div class="col-sm-9 text-secondary">
                        @Model.LastName
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-3 text-muted fw-semibold">Nationality</div>
                    <div class="col-sm-9">
                        <span class="badge bg-light text-dark border font-monospace">
                            @(string.IsNullOrWhiteSpace(Model.Nationality) ? "N/A" : Model.Nationality)
                        </span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-3 text-muted fw-semibold">Birth Date</div>
                    <div class="col-sm-9 text-secondary">
                        <i class="bi bi-calendar-event me-1 text-muted"></i>@Model.BirthDate.ToString("dd MMMM yyyy")
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-3 text-muted fw-semibold">ID</div>
                    <div class="col-sm-9 text-secondary">
                        @Model.Id
                    </div>
                </div>

                <hr />

                <div class="row mb-2">
                    <div class="col-sm-3 text-muted fw-semibold">Created At</div>
                    <div class="col-sm-9 text-secondary small">
                        <i class="bi bi-calendar-plus me-1"></i>@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-3 text-muted fw-semibold">Last Update</div>
                    <div class="col-sm-9 text-secondary small">
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <span title="@Model.UpdatedAt.Value.ToString("F")">
                                <i class="bi bi-clock-history me-1"></i>@Model.UpdatedAt.Value.ToString("dd MMM yyyy, HH:mm")
                            </span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">No updates</span>
                        }
                    </div>
                </div>

                @if (Model.DeletedAt.HasValue)
                {
                    <div class="row mb-2">
                        <div class="col-sm-3 text-muted fw-semibold">Deleted At</div>
                        <div class="col-sm-9 text-danger small">
                            <i class="bi bi-trash me-1"></i>@Model.DeletedAt.Value.ToString("dd MMM yyyy, HH:mm")
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
