@model libraryMVC.Models.Author

@{
    ViewData["Title"] = "Author Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0 fw-bold">@Model.FirstName @Model.LastName</h2>
        <p class="text-muted small mb-0">Author Property Inspector</p>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center py-3">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-person me-2 text-primary"></i>Properties</h5>
                @if (Model.IsActive)
                {
                    <span class="obs-status-dot active">Active</span>
                }
                else
                {
                    <span class="obs-status-dot inactive">Inactive</span>
                }
            </div>
            <div class="card-body py-2">
                <div class="obs-property-row">
                    <div class="obs-property-key"><i class="bi bi-person-v"></i>First Name</div>
                    <div class="obs-property-val">@Model.FirstName</div>
                </div>

                <div class="obs-property-row">
                    <div class="obs-property-key"><i class="bi bi-person-v"></i>Last Name</div>
                    <div class="obs-property-val">@Model.LastName</div>
                </div>

                <div class="obs-property-row">
                    <div class="obs-property-key"><i class="bi bi-globe"></i>Nationality</div>
                    <div class="obs-property-val">
                        <span class="obs-tag-mono">
                            @(string.IsNullOrWhiteSpace(Model.Nationality) ? "N/A" : Model.Nationality)
                        </span>
                    </div>
                </div>

                <div class="obs-property-row">
                    <div class="obs-property-key"><i class="bi bi-calendar-event"></i>Birth Date</div>
                    <div class="obs-property-val text-muted">
                        @Model.BirthDate.ToString("dd MMMM yyyy")
                    </div>
                </div>

                <div class="obs-property-row">
                    <div class="obs-property-key"><i class="bi bi-hash"></i>ID</div>
                    <div class="obs-property-val"><span class="obs-tag-mono">@Model.Id</span></div>
                </div>

                <div class="obs-property-row">
                    <div class="obs-property-key"><i class="bi bi-journal-text"></i>Books</div>
                    <div class="obs-property-val">
                        @if (Model.Books != null && Model.Books.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var book in Model.Books)
                                {
                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" 
                                       class="obs-link-chip"
                                       title="View book details">
                                        <i class="bi bi-book-fill me-1"></i>@book.Title
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">No books associated with this author yet.</span>
                        }
                    </div>
                </div>

                <div class="obs-property-row">
                    <div class="obs-property-key"><i class="bi bi-calendar-plus"></i>Created At</div>
                    <div class="obs-property-val text-muted small">
                        @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                    </div>
                </div>

                <div class="obs-property-row">
                    <div class="obs-property-key"><i class="bi bi-clock-history"></i>Last Update</div>
                    <div class="obs-property-val text-muted small">
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <span title="@Model.UpdatedAt.Value.ToString("F")">
                                @Model.UpdatedAt.Value.ToString("dd MMM yyyy, HH:mm")
                            </span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">No updates</span>
                        }
                    </div>
                </div>

                @if (Model.DeletedAt.HasValue)
                {
                    <div class="obs-property-row">
                        <div class="obs-property-key"><i class="bi bi-trash text-danger"></i>Deleted At</div>
                        <div class="obs-property-val text-danger small">
                            @Model.DeletedAt.Value.ToString("dd MMM yyyy, HH:mm")
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
