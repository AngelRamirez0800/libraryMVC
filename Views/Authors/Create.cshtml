@model libraryMVC.Models.Author

@{
    ViewData["Title"] = "Create Author";
}

<h2 class="mb-3">Create Author</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="FirstName" class="control-label fw-semibold">First Name</label>
                        <input asp-for="FirstName" class="form-control" placeholder="e.g. Gabriel" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="LastName" class="control-label fw-semibold">Last Name</label>
                        <input asp-for="LastName" class="form-control" placeholder="e.g. García Márquez" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Nationality" class="control-label fw-semibold">Nationality</label>
                        <input asp-for="Nationality" class="form-control" placeholder="e.g. Colombian" />
                        <span asp-validation-for="Nationality" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="BirthDate" class="control-label fw-semibold">Birth Date</label>
                        <input asp-for="BirthDate" type="date" class="form-control" />
                        <span asp-validation-for="BirthDate" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-primary shadow-sm me-2">
                            <i class="bi bi-plus-lg me-1"></i> Create
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

