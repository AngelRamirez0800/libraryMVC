@model libraryMVC.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0 fw-bold">@Model.Title</h2>
        <p class="text-muted small mb-0">Book Property Inspector</p>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <!-- Information Column -->
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center py-3">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-book me-2 text-primary"></i>Properties</h5>
                @if (Model.IsActive)
                {
                    <span class="obs-status-dot active">Active</span>
                }
                else
                {
                    <span class="obs-status-dot inactive">Inactive</span>
                }
            </div>
            <div class="card-body py-2">
                <div class="obs-property-row">
                    <div class="obs-property-key"><i class="bi bi-upc-scan"></i>ISBN</div>
                    <div class="obs-property-val"><span class="obs-tag-mono">@Model.Isbn</span></div>
                </div>

                <div class="obs-property-row">
                    <div class="obs-property-key"><i class="bi bi-hash"></i>ID</div>
                    <div class="obs-property-val"><span class="obs-tag-mono">@Model.Id</span></div>
                </div>

                <div class="obs-property-row">
                    <div class="obs-property-key"><i class="bi bi-card-text"></i>Summary</div>
                    <div class="obs-property-val">
                        <div class="summary-wrapper">
                            <div class="summary-content line-clamp-3 text-secondary">
                                @(string.IsNullOrWhiteSpace(Model.Summary) ? "No summary provided." : Model.Summary)
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.Summary) && Model.Summary.Length > 80)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 mt-1 text-decoration-none shadow-none fw-semibold" onclick="toggleSummaryText(this)">
                                    <i class="bi bi-chevron-down me-1"></i>Read more
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <div class="obs-property-row">
                    <div class="obs-property-key"><i class="bi bi-people"></i>Authors</div>
                    <div class="obs-property-val">
                        @if (Model.Authors != null && Model.Authors.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var author in Model.Authors)
                                {
                                    <a asp-controller="Authors" asp-action="Details" asp-route-id="@author.Id"
                                       class="obs-link-chip"
                                       title="View author details">
                                        <i class="bi bi-person-fill me-1"></i>@author.FirstName @author.LastName
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">No authors assigned to this book.</span>
                        }
                    </div>
                </div>

                <div class="obs-property-row">
                    <div class="obs-property-key"><i class="bi bi-tags"></i>Categories</div>
                    <div class="obs-property-val">
                        @if (Model.Categories != null && Model.Categories.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var category in Model.Categories)
                                {
                                    <a asp-controller="Category" asp-action="Details" asp-route-id="@category.Id" class="obs-link-chip">
                                        <i class="bi bi-tag-fill me-1"></i>@category.Name
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-danger">No categories assigned.</span>
                        }
                    </div>
                </div>

                <div class="obs-property-row">
                    <div class="obs-property-key"><i class="bi bi-calendar-plus"></i>Created At</div>
                    <div class="obs-property-val text-muted small">
                        @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                    </div>
                </div>

                <div class="obs-property-row">
                    <div class="obs-property-key"><i class="bi bi-clock-history"></i>Last Update</div>
                    <div class="obs-property-val text-muted small">
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <span title="@Model.UpdatedAt.Value.ToString("F")">
                                @Model.UpdatedAt.Value.ToString("dd MMM yyyy, HH:mm")
                            </span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">No updates</span>
                        }
                    </div>
                </div>

                @if (Model.DeletedAt.HasValue)
                {
                    <div class="obs-property-row">
                        <div class="obs-property-key"><i class="bi bi-trash text-danger"></i>Deleted At</div>
                        <div class="obs-property-val text-danger small">
                            @Model.DeletedAt.Value.ToString("dd MMM yyyy, HH:mm")
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Book Images Section -->
        @if (Model.Images != null && Model.Images.Count > 0)
        {
            <div class="card mb-4">
                <div class="card-header py-3">
                    <h5 class="card-title mb-0 fw-bold"><i class="bi bi-images me-2 text-primary"></i>Book Images (@Model.Images.Count)</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var image in Model.Images.OrderBy(i => i.ImageNumber))
                        {
                            <div class="col-sm-4 mb-3">
                                <div class="card h-100 border">
                                    <img src="~/@image.ImagePath.TrimStart('/')"
                                         class="card-img-top"
                                         alt="Image #@image.ImageNumber"
                                         style="height: 180px; object-fit: cover;" />
                                    <div class="card-body p-2">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-semibold small">Image #@image.ImageNumber</span>
                                            @if (image.IsPrimary)
                                            {
                                                <span class="badge bg-success">Primary</span>
                                            }
                                        </div>
                                        <small class="text-muted d-block small">
                                            <i class="bi bi-hdd me-1"></i>@image.FormattedFileSize
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
