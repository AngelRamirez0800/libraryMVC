@model libraryMVC.Models.Book

@{
    ViewData["Title"] = "Edit Book";
}

<h2 class="mb-3">Edit Book</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" value="@Model.Id" />
                    
                    <div class="form-group mb-3">
                        <label asp-for="Isbn" class="control-label fw-semibold"></label>
                        <input asp-for="Isbn" class="form-control" />
                        <span asp-validation-for="Isbn" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Title" class="control-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Summary" class="control-label fw-semibold"></label>
                        <textarea asp-for="Summary" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Summary" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group form-check mb-3">
                        <label class="form-check-label">
                            <input class="form-check-input" asp-for="IsActive" /> Active 
                        </label>
                    </div>
                    
                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-primary shadow-sm me-2">
                            Save
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

