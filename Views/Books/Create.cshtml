@model libraryMVC.Models.Book

@{
    ViewData["Title"] = "Create Book";
}

<h2 class="mb-3">Create Book</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Isbn" class="control-label fw-semibold"></label>
                        <input asp-for="Isbn" class="form-control" placeholder="e.g. 978-3-16-148410-0" />
                        <span asp-validation-for="Isbn" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Title" class="control-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. One Hundred Years of Solitude" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Summary" class="control-label fw-semibold"></label>
                        <textarea asp-for="Summary" class="form-control" rows="3" placeholder="Brief summary of the book..."></textarea>
                        <span asp-validation-for="Summary" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-primary shadow-sm me-2">
                            <i class="bi bi-plus-lg me-1"></i> Create
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

