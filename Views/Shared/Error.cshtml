@model ErrorViewModel
@{
    ViewData["Title"] = "Error inesperado";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle display-4 text-danger"></i>
    <h1 class="h3 mt-3">No se pudo completar la solicitud</h1>
    <p class="text-muted">Ocurrió un error inesperado. Inténtalo de nuevo más tarde.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">
            Código de seguimiento: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
</div>
