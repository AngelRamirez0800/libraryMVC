@model IEnumerable<libraryMVC.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0 fw-bold">Categories</h2>
        <p class="text-muted small mb-0">Category Directory</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg me-1"></i> Create New</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger m-3">@TempData["Error"]</div>
        }
        <div class="table-responsive">
            <table class="table obs-table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Name</th>
                        <th>Description</th>
                        <th>Books</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold"><a asp-action="Details" asp-route-id="@category.Id" class="text-decoration-none text-light hover-accent">@category.Name</a></td>
                            <td class="text-secondary">@category.Description</td>
                            <td>@category.Books.Count</td>
                            <td>
                                @if (category.IsActive)
                                {
                                    <span class="obs-status-dot active">Active</span>
                                }
                                else
                                {
                                    <span class="obs-status-dot inactive">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="dropdown">
                                    <button class="btn btn-sm border-0 shadow-none p-1 text-secondary" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical fs-5"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@category.Id">
                                                <i class="bi bi-pencil me-2 text-primary"></i> Edit
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-action="Details" asp-route-id="@category.Id">
                                                <i class="bi bi-info-circle me-2 text-info"></i> Details
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            @if (category.IsActive)
                                            {
                                                <form asp-action="Deactivate" asp-route-id="@category.Id" method="post" class="d-inline">
                                                    <button type="submit" class="dropdown-item text-danger" disabled="@(category.Books.Count > 0)" title="@(category.Books.Count > 0 ? "Categories related to books cannot be deactivated" : "Deactivate category")" onclick="return confirm('Are you sure you want to deactivate this category?');">
                                                        <i class="bi bi-trash me-2"></i> Deactivate
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Restore" asp-route-id="@category.Id" method="post" class="d-inline">
                                                    <button type="submit" class="dropdown-item text-success" onclick="return confirm('Are you sure you want to activate this category?');">
                                                        <i class="bi bi-arrow-counterclockwise me-2"></i> Activate
                                                    </button>
                                                </form>
                                            }
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
