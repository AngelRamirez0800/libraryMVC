@model libraryMVC.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h2 class="mb-0 fw-bold">@Model.Name</h2><p class="text-muted small mb-0">Category Property Inspector</p></div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2"><i class="bi bi-pencil me-1"></i> Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
    </div>
</div>

<div class="row"><div class="col-md-8">
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center py-3">
            <h5 class="card-title mb-0 fw-bold"><i class="bi bi-tag me-2 text-primary"></i>Properties</h5>
            @if (Model.IsActive) { <span class="obs-status-dot active">Active</span> } else { <span class="obs-status-dot inactive">Inactive</span> }
        </div>
        <div class="card-body py-2">
            <div class="obs-property-row"><div class="obs-property-key">Name</div><div class="obs-property-val">@Model.Name</div></div>
            <div class="obs-property-row"><div class="obs-property-key">Description</div><div class="obs-property-val">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</div></div>
            <div class="obs-property-row"><div class="obs-property-key">Books</div><div class="obs-property-val">
                @if (Model.Books.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var book in Model.Books)
                        {
                            <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" class="obs-link-chip"><i class="bi bi-book-fill me-1"></i>@book.Title</a>
                        }
                    </div>
                }
                else { <span class="text-muted fst-italic">No books associated with this category.</span> }
            </div></div>
            <div class="obs-property-row"><div class="obs-property-key">ID</div><div class="obs-property-val"><span class="obs-tag-mono">@Model.Id</span></div></div>
        </div>
    </div>
</div></div>
